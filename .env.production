# Production Environment Variables for OCI Deployment
# Copy this to .env and update the passwords

# Database Configuration
DB_ROOT_PASSWORD=nopCommerce_root_super_secure_2024!
DB_PASSWORD=nopCommerce_user_secure_2024!

# Redis Configuration  
REDIS_PASSWORD=nopCommerce_redis_secure_2024!

# Application Configuration
ASPNETCORE_ENVIRONMENT=Production

# Domain Configuration (update with your domain)
DOMAIN_NAME=129.146.167.43

# Security
JWT_SECRET=nopCommerce-jwt-super-secret-key-change-this-in-production-2024
ENCRYPTION_KEY=nopCommerce-encryption-key-32-chars-long

# Performance Settings
MYSQL_INNODB_BUFFER_POOL_SIZE=512M
REDIS_MAX_MEMORY=256mb

# Backup Configuration
BACKUP_RETENTION_DAYS=7